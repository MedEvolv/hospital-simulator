# Supabase — required for run persistence and learning cycle
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key   # NOT the anon key — use service role
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Admin dashboard password (POST /api/admin/auth)
ADMIN_PASSWORD=change-this-before-deploy

# Shared secret between run_simulation.py and learning_cycle.py
# Must be a random string; never expose to the browser
WORKFLOW_SECRET=change-this-before-deploy

# Vercel AI Gateway — for the LLM analysis in learning_cycle.py
VERCEL_AI_GATEWAY_KEY=your-vercel-ai-gateway-key

# OTP console access (email). Phone OTP is the next provider; do not collect both.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_SESSION_SECRET=generate-a-32-byte-random-string

# Email send. If RESEND_API_KEY is set, the app sends a 6-digit code itself.
# If unset, the app uses Supabase Auth email OTP when NEXT_PUBLIC_SUPABASE_* are set.
RESEND_API_KEY=
OTP_FROM_EMAIL=Institutional Mirror <noreply@archlife.in>

# Tests only. Never enable in production.
AUTH_OTP_STUB=0
AUTH_OTP_STUB_CODE=

# Set automatically by Vercel on deployment — do not set manually in production
# VERCEL_URL=your-deployment.vercel.app
