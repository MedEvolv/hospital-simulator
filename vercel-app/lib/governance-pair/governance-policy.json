{
  "_comment": "Governance policy — the single source for tier registries, signals, baseline rules, and checklists. Read by the Advisor (signals + baseline), the Auditor (tiers + checklists), and the lattice (tiers). Policy governs classification and proposal; the lattice's enforcement spine (path guards, T3 no-queue, O_EXCL claim, append-only log) stays in code per ADR amendment 2026-08-15.",
  "tiers": {
    "T0": {
      "label": "Autonomous",
      "ops": ["safe_write", "safe_overwrite", "safe_delete", "read", "list", "search", "grep", "draft", "summarize", "explain", "diff", "status", "log", "find", "create_doc", "append_note", "preview", "compute", "compare", "extract_text", "validate_json", "lint_local", "commit_feature_branch"],
      "default": "allowed",
      "logged": true
    },
    "T1": {
      "label": "Confirmable",
      "ops": ["packet_release", "model_above_budget", "shared_file_overwrite", "push_non_main", "spend_past_cap", "kanban_rewrite", "calendar_write"],
      "default": "confirm",
      "timeout_hours": 24,
      "timeout_default": "allowed"
    },
    "T2": {
      "label": "Human-required",
      "ops": ["deploy", "merge_to_main", "git_push_force", "publish_public", "external_write", "credential_use", "paid_model_call", "modify_covenant", "modify_adr", "rename_canon", "delete_tree", "taste_file_write", "dmz_write", "personal_documents_write"],
      "default": "human",
      "never_default": true,
      "approval_window_hours": 24
    },
    "T3": {
      "label": "Prohibited",
      "ops": ["patient_data_access", "patient_data_train", "safekeeping_delete", "git_dir_delete", "dmz_hard_write"],
      "default": "prohibited",
      "no_queue": true
    }
  },
